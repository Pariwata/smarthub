// Prisma schema for SmartHub — a project-tracking web app.
// Data model follows common project-management conventions:
//   Project -> TaskList -> Task, with people (Member) joined to projects
//   (ProjectMember) and to lists (ListAssignee), and optionally owning tasks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A project being tracked.
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Lifecycle status: planning | active | on_hold | completed | archived
  status      String    @default("active")
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lists   TaskList[]
  tasks   Task[]
  members ProjectMember[]
}

/// A person who can belong to projects, be assigned to lists, and own tasks.
model Member {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  /// Hex color used for the member's avatar chip in the UI.
  avatarColor String   @default("#3366ff")
  createdAt   DateTime @default(now())

  memberships     ProjectMember[]
  listAssignments ListAssignee[]
  assignedTasks   Task[]          @relation("TaskAssignee")
}

/// Membership of a Member in a Project, with a project-scoped role.
model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  memberId  String
  /// Project role: owner | manager | member | viewer
  role      String @default("member")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
}

/// A list (a.k.a. column / workstream) grouping tasks within a project.
model TaskList {
  id        String @id @default(cuid())
  name      String
  order     Int    @default(0)
  projectId String

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  assignees ListAssignee[]
}

/// Assignment of a Member to a TaskList. Member progress on the dashboard is
/// computed over all tasks contained in the lists a member is assigned to.
model ListAssignee {
  id       String @id @default(cuid())
  listId   String
  memberId String

  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([listId, memberId])
}

/// A unit of work within a list/project.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// Workflow status: todo | in_progress | done
  status      String    @default("todo")
  /// Priority: low | medium | high | urgent
  priority    String    @default("medium")
  dueDate     DateTime?
  order       Int       @default(0)
  listId      String
  projectId   String
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list     TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee Member?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}
