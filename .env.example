# SmartHub Authentication API - Environment Configuration
#
# Copy this file to .env and update the values for your environment.
# NEVER commit the .env file to version control!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port on which the server will listen
# Default: 3000
PORT=3000

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================

# Secret key used to sign JWT tokens
# IMPORTANT: Change this to a strong, random value in production!
# Minimum recommended: 32 characters of random alphanumeric characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT token expiration time
# Format: zeit/ms compatible string (e.g., "7d", "24h", "60m", "3600s")
# Default: 7d (7 days)
JWT_EXPIRES_IN=7d
